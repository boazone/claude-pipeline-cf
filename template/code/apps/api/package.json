{
  "name": "@{{name}}/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node wrangler.mjs dev --ip {{local_ip}} --port 443 --local-protocol https --https-cert-path ../../certs/local.{{domain}}.pem --https-key-path ../../certs/local.{{domain}}-key.pem",
    "dev:story": "node wrangler.mjs dev --story",
    "deploy:dev": "node dev.mjs deploy",
    "preview:dev": "node dev.mjs preview-story",
    "wrangler:dev": "node dev.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node wrangler.mjs d1 migrations apply {{name}}-local --local",
    "db:migrations:local": "node wrangler.mjs d1 migrations list {{name}}-local --local",
    "db:migrate:story": "node wrangler.mjs d1 migrations apply {{name}}-local --local --story"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.0.0"
  }
}
