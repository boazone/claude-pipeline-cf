{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../dist-types/browser"
  },
  "include": ["."],
  // The evaluator's git-ignored specs (`eval/`) are not typechecked: `verify` must pass with them there.
  "exclude": ["eval"]
}
